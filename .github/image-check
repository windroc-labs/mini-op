#!/usr/bin/env bash
set -uo pipefail

synopsis="image-check changed [<base>] | build | history | smoke"
usage="$synopsis
The steps of CI's Image job (.github/workflows/ci.yml): it builds host/Dockerfile's image target and
checks it offline, without host/start, the proxy or the mini.
changed: build=true|false for \$GITHUB_OUTPUT, whether an image input changed since <base> (no
base, or one git does not have: true). build: build the image target as mini-op-image-check from
this checkout, stamped as host/start stamps it (ctl/lib/version.sh). history: its history holds no
secret and copies in no mini ssh config or host key. smoke: a PASS/FAIL table of the image's
checks, each from a container without a network or from docker image inspect. Exits 0, 1 (a check
failed) or 2 (usage error)."
bad_usage() {
  echo "image-check: usage: $synopsis" >&2
  exit 2
}
case ${1-} in
  -h | --help)
    [[ $# == 1 ]] || bad_usage
    printf '%s\n' "$usage"
    exit 0
    ;;
  changed) [[ $# -le 2 && ${2-} != -* ]] || bad_usage ;;
  build | history | smoke) [[ $# == 1 ]] || bad_usage ;;
  *) bad_usage ;;
esac

here=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$here")
tag=mini-op-image-check
root=/opt/windroc/mini-op
# The PATH the ensemble layer sets: the runtime must work under it (FR-209).
ensemble_path=/opt/ensemble/bin:/home/agent/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

# What the image is built from, and the scripts this job runs.
INPUTS='^(host/(Dockerfile(\.dockerignore)?|claude-code\.asc|ssh_config\..+)'
INPUTS+='|(skills|ctl|mini|runbooks)/.+|README\.md|\.github/(workflows/ci\.yml|image-check))$'
# FR-34's secret patterns (SECRET_NAMES, SECRET_RES) have one home, written for bash and zsh alike.
secrets_lib=$repo/mini/lib/secrets.zsh
# Only host/start's env stage copies in the mini's ssh config and host key (FR-210).
BAKED='(^| )(COPY|ADD) .*/(ssh_config\.d/mini\.conf|mini_known_hosts)( |$)'

fail() {
  echo "image-check: $*" >&2
  exit 1
}

changed() {
  local base=$1 files
  if [[ -n $base ]] && git rev-parse -q --verify "$base^{commit}" >/dev/null; then
    # --no-renames: a file moved out of an input dir lists its old path too.
    files=$(git diff --no-renames --name-only "$base" HEAD) || fail "git diff $base failed"
    if ! grep -Eq "$INPUTS" <<<"$files"; then
      echo "image-check: no image input changed since $base: no build needed (无需构建)" >&2
      echo build=false
      return
    fi
  fi
  echo build=true
}

checkout_stamp() {
  # shellcheck source=/dev/null
  if ! . "$repo/ctl/lib/version.sh" 2>/dev/null || ! apm_version "$repo"; then
    fail "$repo is not a git checkout; cannot stamp the image"
  fi
}

build() {
  local stamp
  stamp=$(checkout_stamp) || exit 1
  docker build -q -t "$tag" --target image -f "$repo/host/Dockerfile" \
    --build-arg "MINI_OP_VERSION=$stamp" "$repo" >/dev/null || fail "building the image failed"
  echo "built $tag ($stamp)"
}

scan_history() {
  local lines i hits failed=0
  # shellcheck source=/dev/null
  [[ -r $secrets_lib ]] && source "$secrets_lib" && [[ ${#SECRET_RES[@]} -gt 0 ]] ||
    fail "cannot read secret patterns from $secrets_lib"
  lines=$(docker history --no-trunc --format '{{.CreatedBy}}' "$tag") ||
    fail "cannot read the history of $tag"
  for i in "${!SECRET_RES[@]}"; do
    # Line numbers only: the matched text is a secret.
    hits=$(grep -En -- "${SECRET_RES[$i]}" <<<"$lines" | cut -d : -f 1 | tr '\n' ' ')
    [[ -z $hits ]] && continue
    echo "image-check: $tag history line(s) ${hits% } match ${SECRET_NAMES[$i]}" >&2
    failed=1
  done
  hits=$(grep -En -- "$BAKED" <<<"$lines" | cut -d : -f 1 | tr '\n' ' ')
  if [[ -n $hits ]]; then
    echo "image-check: $tag history line(s) ${hits% } copy in the mini's ssh config or host key" >&2
    failed=1
  fi
  [[ $failed == 1 ]] || echo "history clean: $tag"
  return "$failed"
}

smoke() {
  local failed=0 r out uid stamp tool flag file
  row() { # check result
    printf '%-40s | %s\n' "$1" "$2"
    [[ $2 == PASS ]] || failed=1
  }
  in_image() { docker run --rm --network none "$tag" "$@" 2>/dev/null; }
  in_image claude --version >/dev/null && r=PASS || r=FAIL
  row "claude --version" "$r"
  in_image sh -c '! command -v python3' >/dev/null && r=PASS || r=FAIL
  row "no python3 on PATH" "$r"
  out=$(in_image id) || out=
  uid=
  [[ $out =~ ^uid=([0-9]+)\(agent\) ]] && uid=${BASH_REMATCH[1]}
  [[ -n $uid && $uid != 0 ]] && r=PASS || r=FAIL
  row "user agent, non-root (uid ${uid:-?})" "$r"
  for tool in npm node git apt-get dpkg tmux; do
    flag=--version
    [[ $tool == tmux ]] && flag=-V
    in_image "$tool" "$flag" >/dev/null && r=PASS || r=FAIL
    row "$tool $flag" "$r"
  done
  stamp=$(checkout_stamp 2>/dev/null) || stamp=
  out=$(in_image cat "$root/mini/VERSION") || out=
  [[ -n $stamp && $out == "$stamp" ]] && r=PASS || r=FAIL
  row "mini/VERSION ${stamp:-?}" "$r"
  in_image test -r /etc/claude-code/.claude/skills/mini-op/SKILL.md && r=PASS || r=FAIL
  row "standalone mini-op skill readable" "$r"
  out=$(docker image inspect -f '{{range $k, $v := .Config.Labels}}{{println $k}}{{end}}' \
    "$tag" 2>/dev/null) && ! grep -Eq '^(windroc|ensemble)\.' <<<"$out" && r=PASS || r=FAIL
  row "no windroc./ensemble. label" "$r"
  out=$(in_image find /home/agent -mindepth 1) && [[ -z $out ]] && r=PASS || r=FAIL
  row "/home/agent is empty" "$r"
  docker run --rm --network none -e "PATH=$ensemble_path" -w /tmp "$tag" \
    "$root/ctl/mini" -h \
    >/dev/null 2>&1 && r=PASS || r=FAIL
  row "ctl/mini -h, ensemble PATH, cwd /tmp" "$r"
  for tool in ssh zsh jq; do
    flag=--version
    [[ $tool == ssh ]] && flag=-V
    in_image "$tool" "$flag" >/dev/null && r=PASS || r=FAIL
    row "$tool $flag" "$r"
  done
  in_image sh -c 'command -v nc' >/dev/null && r=PASS || r=FAIL
  row "nc on PATH" "$r"
  in_image sh -c '! command -v sudo' >/dev/null && r=PASS || r=FAIL
  row "no sudo on PATH" "$r"
  for file in ssh_config.d/mini.conf mini_known_hosts; do
    in_image test ! -e "/etc/ssh/$file" && r=PASS || r=FAIL
    row "no $file" "$r"
  done
  return "$failed"
}

case $1 in
  changed) changed "${2-}" ;;
  build) build ;;
  history) scan_history ;;
  smoke) smoke ;;
esac
