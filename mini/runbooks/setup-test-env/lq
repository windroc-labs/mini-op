#!/usr/bin/env zsh
usage='lq <json-body-file>   send that GraphQL body to the Linear API; the keychain key
(agentpm-test-linear-key; service lookup preserves the existing item account) goes to curl as its Authorization header through stdin.
Prints the reply. Exits 0, 1 (the file is unreadable, the key is not in the keychain, or curl
failed) or 2 (usage error).'
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
[[ $# -eq 1 && -n $1 && $1 != -* ]] || { print -u2 -r -- 'lq: usage: lq <json-body-file>'; exit 2; }
[[ -f $1 && -r $1 ]] || { print -u2 -r -- "lq: cannot read $1"; exit 1; }
source ${0:A:h}/../../lib/keychain.zsh || exit 1
keychain_has agentpm-test-linear-key ||
  { print -u2 -r -- 'lq: no agentpm-test-linear-key key in the keychain'; exit 1; }
keychain_read agentpm-test-linear-key |
  sed "s/^/Authorization: /" |
  curl -s https://api.linear.app/graphql -H @- -H "Content-Type: application/json" \
    --data-binary @"$1"
st=($pipestatus)
(( st[1] == 0 )) ||
  { print -u2 -r -- 'lq: cannot read agentpm-test-linear-key from the keychain'; exit 1; }
(( st[3] == 0 )) || { print -u2 -r -- "lq: curl exited $st[3]"; exit 1; }
