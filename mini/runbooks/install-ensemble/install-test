#!/usr/bin/env zsh
usage='install-test [--ref <ref>] [-- <install.sh flags>]   run install.sh from windroc-labs/ensemble, in
this Terminal; its sudo password is typed at its prompt (mini pw from mini-op). --ref picks the branch or commit (default main), CLIENTS=<list> adds --clients <list>, OC=1 adds the Strata
OpenCode flags, their URL, model and context from strata.conf beside it; flags after -- go to
install.sh unchanged. Prints "install.sh exited <rc>"; exits 0
(it exited 0), 1 (strata.conf lacks a setting, the download failed, or it exited non-zero) or 2
(usage error).'
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
ref=main
if [[ $1 == --ref && $# -ge 2 && -n $2 && $2 != -* && $2 != *[[:space:]]* ]]; then ref=$2; shift 2; fi
[[ $# -eq 0 || $1 == -- ]] ||
  { print -u2 -r -- 'install-test: usage: install-test [--ref <ref>] [-- <install.sh flags>]'; exit 2; }
shift $(( $# > 0 ))
[[ $ref =~ '^[A-Za-z0-9_][A-Za-z0-9._/-]*$' && $ref != *..* && $ref != *//* &&
  $ref != */.* && $ref != */ && $ref != *. && $ref != *.lock && $ref != *.lock/* ]] ||
  { print -u2 -r -- 'install-test: invalid ref; use a safe branch or commit'; exit 2; }
conf=${0:A:h}/strata.conf; oc=()
if [[ -n $OC ]]; then
  typeset -A strata
  [[ -r $conf ]] || { print -u2 -r -- "install-test: $conf cannot be read; ran nothing"; exit 1; }
  while IFS== read -r k v || [[ -n $k ]]; do [[ $k == [a-z]* ]] && strata[$k]=$v; done < $conf
  for k in url model context; do
    [[ -n $strata[$k] ]] || { print -u2 -r -- "install-test: $conf has no $k; ran nothing"; exit 1; }
    oc+=(--opencode-$k $strata[$k])
  done
  oc=(--opencode-provider strata $oc)
fi
url=https://raw.githubusercontent.com/windroc-labs/ensemble/$ref/scripts/install.sh
script=$(curl -fsSL $url) ||
  { print -u2 -r -- "install-test: cannot fetch $url; ran nothing"; exit 1; }
bash -c "$script" install.sh --ref $ref \
    ${=CLIENTS:+--clients $CLIENTS} \
    $oc \
    "$@"
rc=$?
echo "install.sh exited $rc"
(( rc == 0 ))
