#!/usr/bin/env zsh
usage='o <command> [args...]   run opencli browser in a foreground window; --private hides Chrome
first and uses a background window for secret-bearing pages. Never print a private secret reply.
opencli is found in /usr/local/bin or ~/.npm-global/bin after the mini'"'"'s own PATH; exits as it does
o evalfile <session> <file.js> [--private]   o eval with the file'"'"'s JS as one argument, no shell
quoting (/dev/stdin: piped over ssh); the JS must be public. Exits 1 for a missing or empty file'
[[ $# -eq 1 && $1 == -h ]] && { print -r -- $usage; exit 0; }
[[ $# -ge 1 && -n $1 && $1 != -* ]] || { print -u2 -r -- 'o: usage: o <command> [args...]'; exit 2; }
export PATH=$PATH:/usr/local/bin:$HOME/.npm-global/bin
args=(); private=0
while (( $# )); do
  case $1 in
    --private) private=1; shift ;;
    --window|--window=*) print -u2 -r -- 'o: --window is not supported; window placement is automatic'; exit 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
if [[ ${args[1]} == evalfile ]]; then
  [[ ${#args} -eq 3 && -n ${args[2]} && -n ${args[3]} && ${args[2]} != -* && ${args[3]} != -* ]] ||
    { print -u2 -r -- 'o: usage: o evalfile <session> <file.js> [--private]'; exit 2; }
  file=${args[3]}
  [[ -r $file && ! -d $file ]] && js=$(<$file) || { print -u2 -r -- "o: cannot read $file"; exit 1; }
  [[ -n ${js//[[:space:]]/} ]] || { print -u2 -r -- "o: $file is empty"; exit 1; }
  args=(eval "$js" --session "${args[2]}")
fi
if (( private )); then
  osascript -l JavaScript ~/apm/js/chrome.js hide >/dev/null || exit 1
  window=background
else window=foreground
fi
exec opencli browser "${args[@]}" --window $window
