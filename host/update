#!/usr/bin/env bash
set -euo pipefail
usage="update   run on the user's Mac: refresh /opt/mini-op in the running container, without
restarting it. ctl/ goes on the container's PATH; ctl/CLAUDE.md, the operator's instructions, lands
as /opt/mini-op/CLAUDE.md; mini/ is the mini's ~/apm copy, kept off PATH, with mini/VERSION stamped
from this checkout for mini sync. It runs host/config first; ~/.mini-op/ssh_config, the mini's
address and account it generates, replaces the container's ssh config (written as root). It copies
nothing unless the running mini-op-proxy carries the policy host/config generated (its label): a
changed mini_host, mini_port or proxy_* key needs host/start. Exits 0, 1 (not a git checkout,
host/config failed, the proxy's policy differs, or the copy failed) or 2 (usage error)."
if [ $# -eq 1 ] && [ "$1" = -h ]; then
  printf '%s\n' "$usage"
  exit 0
fi
[ $# -eq 0 ] || {
  echo "update: usage: update" >&2
  exit 2
}
here=$(cd "$(dirname "$0")" && pwd -P)
env_dir=$(dirname "$here")
# shellcheck source=/dev/null
. "$env_dir/ctl/lib/version.sh"
stamp=$(mktemp -d)
trap 'rm -rf -- "${stamp:?}"' EXIT
mkdir "$stamp/mini"
apm_version "$env_dir" >"$stamp/mini/VERSION" || {
  echo "update: $env_dir is not a git checkout; cannot stamp mini/VERSION" >&2
  exit 1
}

if ! "$here/config" >/dev/null || ! policy=$("$here/config" policy-hash); then
  echo "update: host/config failed; nothing copied" >&2
  exit 1
fi
label='{{index .Config.Labels "mini-op.proxy-policy"}}'
if ! running=$(docker inspect -f "$label" mini-op-proxy 2>/dev/null); then
  echo "update: no mini-op-proxy container; run host/start" >&2
  exit 1
fi
if [[ $running != "$policy" ]]; then
  echo "update: the proxy's policy differs from the config (mini_host, mini_port or proxy_*" \
    "changed); run host/start" >&2
  exit 1
fi

# bsdtar on macOS: omit xattrs, AppleDouble files and macOS metadata. Also allow GNU tar for offline
# tests.
export COPYFILE_DISABLE=1
tar_flags=(--no-xattrs)
if [[ $(tar --version) == *bsdtar* ]]; then
  tar_flags+=(--no-mac-metadata)
fi
fail() {
  echo "update: copying into mini-op failed" >&2
  exit 1
}
# mini/'s entries, not mini/ itself: a VERSION left in the checkout must not override the stamp, and
# a read-only mini/ dir entry would leave the extracted dir unwritable for it.
mini_entries=()
for f in "$env_dir"/mini/* "$env_dir"/mini/.[!.]*; do
  [ -e "$f" ] || continue
  f=mini/${f##*/}
  [ "$f" = mini/VERSION ] || mini_entries+=("$f")
done
tar "${tar_flags[@]}" --exclude ctl/CLAUDE.md -cf - -C "$stamp" mini/VERSION \
  -C "$env_dir" README.md status.md runbooks "${mini_entries[@]}" ctl |
  docker exec -i mini-op tar -xf - -C /opt/mini-op || fail
tar -C "$env_dir/ctl" "${tar_flags[@]}" -cf - CLAUDE.md |
  docker exec -i mini-op tar -xf - -C /opt/mini-op || fail
# The container's Host mini comes only from here. The file is root's, so root writes it (all
# capabilities are still dropped).
docker exec -i -u 0 mini-op sh -c 'cat > /etc/ssh/ssh_config.d/mini.conf' \
  <"$HOME/.mini-op/ssh_config" || fail
echo "mini-op files updated (mini/VERSION $(cat "$stamp/mini/VERSION")), its ssh config too;" \
  "container, secrets and sessions kept running; run mini sync in mini-op to copy mini/ to the mini"
