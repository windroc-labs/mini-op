#!/usr/bin/env bash
set -euo pipefail
usage="config [get <key> | policy-hash]   run on the user's Mac: merge host/config.yaml (every key
with its default) with ~/.mini-op/config.local.yaml (the keys this Mac sets: at least mini_host and
mini_user, the mini's address and account), check the result, and write ~/.mini-op/ssh_config
(Host mini), ~/.mini-op/proxy/config.yaml and ~/.mini-op/proxy/acl.yaml (smokescreen's config and
ACL) for ctl/ and host/start. A local key replaces the default; a list replaces the
whole list, but proxy_deny_ranges must keep every default range. Both files are one key: value
line per key (a value: \"\", \"text\", text or [a, b]); # starts a comment. get prints one merged
value (a list: its items, space-separated) and writes nothing; policy-hash prints the SHA-256 of
the generated proxy/config.yaml and proxy/acl.yaml. Exits 0, 1 (no local file; a key empty,
unknown, malformed or invalid: nothing written; or a write failed: files already moved into place
stay) or 2 (usage error)."
bad_usage() {
  echo "config: usage: config [get <key> | policy-hash]" >&2
  exit 2
}
case $#:${1-} in
  1:-h)
    printf '%s\n' "$usage"
    exit 0
    ;;
  0:) mode=generate ;;
  2:get) mode=print_value ;;
  1:policy-hash) mode=policy_hash ;;
  *) bad_usage ;;
esac
# Values are data: no word of them may match files.
set -f
here=$(cd "$(dirname "$0")" && pwd -P)
base=$here/config.yaml
dir=$HOME/.mini-op
local_file=$dir/config.local.yaml
header="# Generated by host/config from host/config.yaml and ~/.mini-op/config.local.yaml;"
header+=" do not edit."

if [[ $mode == policy_hash ]]; then
  [[ -f $dir/proxy/config.yaml && -f $dir/proxy/acl.yaml ]] || {
    echo "config: no generated proxy files in $dir/proxy; run host/config" >&2
    exit 1
  }
  hash=$(cat "$dir/proxy/config.yaml" "$dir/proxy/acl.yaml" | shasum -a 256)
  echo "${hash%% *}"
  exit 0
fi
if [[ ! -f $local_file ]]; then
  echo "config: no $local_file; create it with mini_host: <the mini's LAN IPv4> and" \
    "mini_user: <the mini's account> (host/README.md, Steps)" >&2
  exit 1
fi

# The base's keys in order, with their kind (scalar | list), default and merged value (a list's
# items joined by one space).
keys=() kinds=() defaults=() values=() errors=()
problem() { errors[${#errors[@]}]=$*; }
index_of() {
  local i
  for ((i = 0; i < ${#keys[@]}; i++)); do
    [[ ${keys[i]} == "$1" ]] && echo "$i" && return 0
  done
  return 1
}
value_of() { echo "${values[$(index_of "$1")]}"; }

re_skip='^[[:space:]]*(#.*)?$'
re_key='^([a-z_][a-z0-9_]*):[[:space:]]*(.*)$'
tail_re='([[:space:]]+#.*)?[[:space:]]*$'
re_empty="^\"\"$tail_re"
re_quoted="^\"([^\"\\\\]*)\"$tail_re"
re_bare="^([^][#\",[:space:]]+)$tail_re"
re_list="^\\[([^]#\"]*)\\]$tail_re"
re_item='^[[:space:]]*([^][#",[:space:]]+)[[:space:]]*$'

# parse <file> <base|local>: reads key: value lines into the arrays; a problem names file:line.
parse() {
  local file=$1 role=$2 n=0 line key raw kind value item i seen=" "
  local -a items
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ $re_skip ]] && continue
    if [[ ! $line =~ $re_key ]]; then
      problem "$file:$n: not a key: value line at the start of the line"
      continue
    fi
    key=${BASH_REMATCH[1]} raw=${BASH_REMATCH[2]}
    if [[ $raw =~ $re_empty ]]; then
      kind=scalar value=''
    elif [[ $raw =~ $re_quoted || $raw =~ $re_bare ]]; then
      kind=scalar value=${BASH_REMATCH[1]}
    elif [[ $raw =~ $re_list ]]; then
      kind=list value='' raw=${BASH_REMATCH[1]}
      if [[ $raw =~ [^[:space:]] ]]; then
        IFS=, read -r -a items <<<"$raw,"
        for item in "${items[@]}"; do
          if [[ ! $item =~ $re_item ]]; then
            problem "$file:$n: $key: list items are plain words separated by commas"
            continue 2
          fi
          value="$value${value:+ }${BASH_REMATCH[1]}"
        done
      fi
    else
      problem "$file:$n: $key: the value must be \"\", \"text\", text or [a, b] on this line"
      continue
    fi
    if [[ $seen == *" $key "* ]]; then
      problem "$file:$n: $key is given twice"
      continue
    fi
    seen="$seen$key "
    if [[ $role == base ]]; then
      i=${#keys[@]}
      keys[i]=$key kinds[i]=$kind defaults[i]=$value values[i]=$value
    elif ! i=$(index_of "$key"); then
      problem "$file:$n: unknown key $key; host/config.yaml lists the keys"
    elif [[ ${kinds[i]} != "$kind" ]]; then
      if [[ ${kinds[i]} == list ]]; then
        problem "$file:$n: $key takes a list: [a, b]"
      else
        problem "$file:$n: $key takes one value, not a list"
      fi
    else
      values[i]=$value
    fi
  done <"$file"
}

report() {
  ((${#errors[@]} == 0)) && return 0
  printf 'config: %s\n' "${errors[@]}" >&2
  exit 1
}

# octet <text>: a decimal 0-255 without a leading zero.
octet() { [[ $1 =~ ^(0|[1-9][0-9]{0,2})$ ]] && (($1 <= 255)); }

validate() {
  local host user port item a b c d
  local -a domains ranges floor
  host=$(value_of mini_host) user=$(value_of mini_user) port=$(value_of mini_port)
  read -r -a domains <<<"$(value_of proxy_allowed_domains)"
  read -r -a ranges <<<"$(value_of proxy_deny_ranges)"
  read -r -a floor <<<"${defaults[$(index_of proxy_deny_ranges)]}"
  [[ -n $host ]] || problem "mini_host is empty; set it in $local_file"
  [[ -n $user ]] || problem "mini_user is empty; set it in $local_file"
  if [[ -n $host ]]; then
    IFS=. read -r a b c d <<<"$host"
    if ! { [[ $host =~ ^[0-9.]+$ ]] && octet "$a" && octet "$b" && octet "$c" && octet "$d" &&
      [[ $host == "$a.$b.$c.$d" ]]; } ||
      ! { ((a == 10)) || ((a == 172 && b >= 16 && b <= 31)) || ((a == 192 && b == 168)); }; then
      problem "mini_host $host is not a private IPv4 address (10/8, 172.16/12, 192.168/16)"
    fi
  fi
  [[ -z $user || $user =~ ^[a-z_][a-z0-9_-]*$ ]] ||
    problem "mini_user $user is not an account name ([a-z_][a-z0-9_-]*)"
  if [[ ! $port =~ ^[1-9][0-9]{0,4}$ ]] || ((port > 65535)); then
    problem "mini_port $port is not a port (1-65535)"
  fi
  for item in ${domains[@]+"${domains[@]}"}; do
    [[ $item =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] ||
      problem "proxy_allowed_domains item $item is not a host name"
  done
  for item in ${ranges[@]+"${ranges[@]}"}; do
    [[ $item =~ ^[0-9a-f:.]+/[0-9]+$ ]] ||
      problem "proxy_deny_ranges item $item is not a CIDR range"
  done
  for item in "${floor[@]}"; do
    [[ " ${ranges[*]-} " == *" $item "* ]] ||
      problem "proxy_deny_ranges misses $item (host/config.yaml's ranges stay denied)"
  done
}

parse "$base" base
report
parse "$local_file" local
report
validate
report

if [[ $mode == print_value ]]; then
  index_of "$2" >/dev/null || {
    echo "config: unknown key $2" >&2
    exit 1
  }
  value_of "$2"
  exit 0
fi

# The generated files, each first written to <file>.new beside it; all are moved into place only
# once every write succeeded.
host=$(value_of mini_host) port=$(value_of mini_port)
new=.new
trap 'rm -f -- "${dir:?}/ssh_config.new" "${dir:?}/proxy/config.yaml.new" \
  "${dir:?}/proxy/acl.yaml.new"' EXIT
fail() {
  echo "config: cannot write the generated files in $dir: $*" >&2
  exit 1
}
umask 077
[[ -d $dir/proxy ]] || mkdir "$dir/proxy" 2>/dev/null || fail "mkdir proxy"
read -r -a domains <<<"$(value_of proxy_allowed_domains)"
read -r -a ranges <<<"$(value_of proxy_deny_ranges)"
{
  printf '%s\nHost mini\n' "$header"
  printf '    HostName %s\n    User %s\n    Port %s\n' "$host" "$(value_of mini_user)" "$port"
} 2>/dev/null >"$dir/ssh_config$new" || fail ssh_config
{
  printf '%s\n' "$header" \
    "# smokescreen settings for mini-op-proxy. Clients have no TLS role, so every request gets" \
    "# acl.yaml's default rule." \
    "ip: 0.0.0.0" "port: 4750" "acl_file: /etc/smokescreen/acl.yaml" "allow_missing_role: true" \
    "# The ACL has no ports: this is the only private address allowed, and only its ssh port." \
    "allow_addresses:" "  - $host:$port" "deny_ranges:"
  printf '  - %s\n' "${ranges[@]}"
} 2>/dev/null >"$dir/proxy/config.yaml$new" || fail proxy/config.yaml
{
  printf '%s\n' "$header" \
    "# Hosts mini-op may reach through mini-op-proxy, and the mini (config.yaml limits its port)." \
    "# Everything else is denied." \
    "version: v1" "services: []" "default:" "  project: mini-op" "  action: enforce" \
    "  allowed_domains:"
  printf '    - %s\n' ${domains[@]+"${domains[@]}"} "$host"
} 2>/dev/null >"$dir/proxy/acl.yaml$new" || fail proxy/acl.yaml
for f in ssh_config proxy/config.yaml proxy/acl.yaml; do
  mv -f -- "$dir/$f$new" "$dir/$f" || fail "moving $f into place"
done
echo "config: wrote $dir/ssh_config, proxy/config.yaml, proxy/acl.yaml"
