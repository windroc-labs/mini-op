#!/usr/bin/env bash
set -uo pipefail
usage="verify-egress   after host/start, check the direct-use broker container selected by
windroc.lock=mini-op and windroc.lock.owner=mini-op. Prints only two PASS/FAIL rows: claude -p
answers, and ssh mini echo ok. Replies and command errors are not printed. Network blocking
checks belong to egress. Exits 0, 1 (missing/ambiguous session or failed check), or 2 (usage)."
case $#:${1-} in
  0:) ;;
  1:-h | 1:--help)
    printf '%s\n' "$usage"
    exit 0
    ;;
  *)
    echo "verify-egress: usage: verify-egress" >&2
    exit 2
    ;;
esac
die() {
  echo "verify-egress: $*; run host/start" >&2
  exit 1
}
ids=$(docker ps -q --no-trunc --filter label=windroc.lock=mini-op \
  --filter label=windroc.lock.owner=mini-op) || die "cannot list containers"
case $ids in
  '') die "no direct-use mini-op container" ;;
  *$'\n'*) die "several direct-use mini-op containers" ;;
esac
failed=0
row() {
  printf '%-24s | %s\n' "$1" "$2"
  [[ $2 == PASS ]] || failed=1
}
in_op() { docker exec "$ids" "$@" 2>/dev/null; }

reply=$(in_op timeout 120 claude -p 'Reply with exactly: ok' </dev/null) && rc=0 || rc=$?
reply=$(printf '%s' "$reply" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
[[ $rc == 0 && ${reply%.} == ok ]] && r=PASS || r=FAIL
row "claude -p answers" "$r"

reply=$(in_op timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=10 mini echo ok \
  </dev/null) && rc=0 || rc=$?
[[ $rc == 0 && $reply == ok ]] && r=PASS || r=FAIL
row "ssh mini echo ok" "$r"
exit "$failed"
