#!/usr/bin/env bash
set -euo pipefail
usage="start   refuse legacy resources (host/README.md, 从旧版升级), run host/config, stamp this
checkout and build mini-op:env with the host key from ~/.mini-op/known_hosts. Refuses untracked
or ignored runtime files and missing confirmed keys before any build. Open session mini-op via
ensemble-delegate, environment mini-op, client claude, cwd ~/.mini-op/workspace (created if absent).
Exits 0, 1 (preflight/build failure), 2 (usage/configuration) or 75 (broker lock busy); delegate
status and stderr pass through unchanged. No containers or networks are created here."
if [ $# -eq 1 ] && [ "$1" = -h ]; then
  printf '%s\n' "$usage"
  exit 0
fi
[ $# -eq 0 ] || {
  echo "start: usage: start" >&2
  exit 2
}
trap 'echo "start: failed (exit $?): $BASH_COMMAND" >&2; exit 1' ERR
here=$(cd "$(dirname "$0")" && pwd)
repo=$(dirname "$here")
fail() {
  echo "start: $*" >&2
  exit 1
}
# Read-only migration guard, before even generating configuration. The suffixes describe the
# retired resources; no old lifecycle code remains.
name=mini-op
docker info >/dev/null || fail "cannot contact Docker; nothing built"
containers=$(docker ps -a --format '{{.Names}}') || fail "cannot list containers; nothing built"
networks=$(docker network ls --format '{{.Name}}') || fail "cannot list networks; nothing built"
volumes=$(docker volume ls --format '{{.Name}}') || fail "cannot list volumes; nothing built"
if grep -Fxq "$name" <<<"$containers" || grep -Fxq "$name-proxy" <<<"$containers" ||
  grep -Fxq "$name-net" <<<"$networks" || grep -Fxq "$name-home" <<<"$volumes"; then
  fail "legacy resources exist; see host/README.md, 从旧版升级; nothing built"
fi
if ! "$here/config" >/dev/null; then
  fail "host/config failed; nothing built or changed"
fi
# shellcheck source=/dev/null
. "$repo/ctl/lib/version.sh"
stamp=$(apm_version "$repo") || {
  echo "start: $repo is not a git checkout; cannot stamp the runtime version" >&2
  exit 1
}
# Ignored files count too, except what host/Dockerfile.dockerignore keeps out of the build.
listed=$(git -C "$repo" status --porcelain --untracked-files=all --ignored -- ctl mini runbooks \
  skills | sed -nE 's/^(\?\?|!!) //p' |
  { grep -Ev '^mini/VERSION$|(^|/)(node_modules|\.tools)(/|$)' || true; } | tr '\n' ' ')
if [[ -n $listed ]]; then
  echo "start: untracked or ignored files would be built into the image: ${listed% }; commit or" \
    "remove them" >&2
  exit 1
fi
# Only mini-op's pin, enrolled explicitly with host/pin-host-key; never scan or re-trust here.
host=$("$here/config" get mini_host)
port=$("$here/config" get mini_port)
entry=$host
[[ $port == 22 ]] || entry="[$host]:$port"
keys=$(ssh-keygen -F "$entry" -f "$HOME/.mini-op/known_hosts" 2>/dev/null | grep -v '^#') || keys=
if [[ -z $keys ]]; then
  echo "start: ~/.mini-op/known_hosts has no host key for $entry; run host/pin-host-key," \
    "then rerun host/start" >&2
  exit 1
fi
# The build's named context mini: what the image's last stage adds about the mini.
umask 077
context=$(mktemp -d)
trap 'rm -rf -- "${context:?}"' EXIT
cp "$HOME/.mini-op/ssh_config" "$context/ssh_config"
printf '%s\n' "$keys" >"$context/known_hosts"

image=mini-op:env
docker build -q -t "$image" -f "$here/Dockerfile" --build-arg "MINI_OP_VERSION=$stamp" \
  --build-context "mini=$context" "$repo" >/dev/null || fail "building $image failed"
mkdir -p "$HOME/.mini-op/workspace"
# WDRC-229: broker variant builds currently need world-readable build files. Only this call
# uses 022; the mini context above stays private. Capture status so ERR never rewrites it.
umask 022
rc=0
ensemble-delegate open mini-op --environment mini-op --client claude \
  --cwd "$HOME/.mini-op/workspace" || rc=$?
exit "$rc"
