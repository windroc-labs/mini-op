# Only the broker-injected identity and the confirmed, baked host key.
Match originalhost mini !exec "env test -r /run/ensemble/secrets/env/mini-ssh-key"
    ProxyCommand sh -c 'echo "ssh mini: missing or unreadable /run/ensemble/secrets/env/mini-ssh-key; import with ensemble-broker login env mini-op-ssh-key" >&2; exit 1'
Match originalhost mini
    IdentityFile /run/ensemble/secrets/env/mini-ssh-key
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /dev/null
    GlobalKnownHostsFile /etc/ssh/mini_known_hosts
