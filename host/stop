#!/usr/bin/env bash
set -uo pipefail
usage="stop   stop container mini-op, then its proxy mini-op-proxy, keeping both (and the volume)
for a later host/resume; stopping clears /run/secrets. A missing container is skipped (a note on
stderr). Exits 0, 1 (Docker is not reachable, or a stop failed: it still tries both) or 2 (usage
error)."
if [ $# -eq 1 ] && [ "$1" = -h ]; then
  printf '%s\n' "$usage"
  exit 0
fi
[ $# -eq 0 ] || {
  echo "stop: usage: stop" >&2
  exit 2
}
status=0
for name in mini-op mini-op-proxy; do
  if ! docker inspect -f '{{.Name}}' "$name" >/dev/null 2>&1; then
    # inspect also fails when Docker itself is down: tell that apart from a missing container.
    if docker info >/dev/null 2>&1; then
      echo "stop: no container $name, skipped" >&2
    else
      echo "stop: Docker is not reachable" >&2
      exit 1
    fi
  elif docker stop "$name" >/dev/null; then
    echo "stopped $name"
  else
    echo "stop: could not stop $name" >&2
    status=1
  fi
done
exit "$status"
