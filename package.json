{
  "name": "mini-op",
  "private": true,
  "type": "module",
  "scripts": {
    "coverage": "node .github/coverage.ts",
    "test": "node --test --test-timeout=60000 'tests/**/*.test.ts'",
    "format": "node .github/format.ts",
    "format:write": "node .github/format.ts --write",
    "guards": "node tests/guards/run.ts",
    "lint": "node .github/lint.ts",
    "typecheck": "tsc -p tsconfig.json && node .github/jxa.ts",
    "jxa:write": "node .github/jxa.ts --write"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
